SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=https://www.valueraq.com
ENFORCE_CANONICAL_HOST=1
DATABASE_PATH=/var/data/valueraq.db
ADMIN_EMAILS=you@example.com
CONTACT_EMAIL=hello@valueraq.com
# Payments (optional until you're ready to charge)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FEATURED_MONTHLY=
STRIPE_PRICE_FEATURED_YEARLY=
# Search engine verification meta tags
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Comma-separated user agents to block entirely (default: none)
BLOCKED_CRAWLERS=
SOCIAL_PROFILES=
TWITTER_HANDLE=

# Email through Resend (optional). Without a key the site simply sends nothing.
RESEND_API_KEY=
EMAIL_FROM=VALUERAQ <no-reply@valueraq.com>

# Daily database backups to Cloudflare R2 (optional)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
